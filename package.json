{
  "name": "workflow-runner",
  "version": "0.1.0",
  "private": true,
  "description": "Исполнение версионируемых процессов с восстановлением после сбоев",
  "engines": {
    "node": ">=22.17.0 <23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/src/main.js",
    "worker": "node dist/src/worker.js",
    "migrate": "ts-node scripts/migrate.ts",
    "test": "jest",
    "lint": "eslint .",
    "format": "prettier --write . --ignore-path .gitignore --ignore-unknown",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-unknown"
  },
  "dependencies": {
    "@nestjs/common": "11.1.27",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.27",
    "@nestjs/platform-express": "11.1.27",
    "@nestjs/throttler": "6.5.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.8.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.219.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.219.0",
    "@opentelemetry/sdk-metrics": "2.8.0",
    "@opentelemetry/sdk-trace-base": "2.8.0",
    "@opentelemetry/sdk-trace-node": "2.8.0",
    "bullmq": "5.79.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "helmet": "8.2.0",
    "pg": "8.22.0",
    "pino": "10.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.0",
    "@types/pg": "8.20.0",
    "@types/supertest": "7.2.0",
    "eslint": "9.39.4",
    "jest": "30.4.2",
    "prettier": "3.9.4",
    "supertest": "7.2.2",
    "ts-jest": "29.4.11",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.62.1"
  },
  "overrides": {
    "multer": "2.2.0"
  }
}
